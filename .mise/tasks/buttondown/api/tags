#!/usr/bin/env bun
//MISE description="List Buttondown tags with sanitized fields"
//USAGE flag "--page-size <page_size>" default="1000" help="Tag results per page"
//USAGE flag "--json" default=#false help="Print machine-readable JSON"

import { runResource } from '../../../../scripts/buttondown/api.mjs';
import { printTask, usageFlag } from '../../../../scripts/buttondown/task.mjs';

await printTask(() => runResource('tags', {
  pageSize: process.env.usage_page_size ?? '1000',
}), {
  json: usageFlag('json'),
});
