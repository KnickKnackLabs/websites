#!/usr/bin/env bun
//MISE description="Read Zillow listing evidence and rendered photo metadata (read-only)"
//USAGE arg "<url>" help="Zillow homedetails or building URL"
//USAGE flag "--calculator" help="Read the cost calculator if unambiguously available"
//USAGE flag "--unit <number>" help="Select an exact available building unit (requires --calculator)"
//USAGE flag "--browser <id>" help="Use an existing browser; only a new owned tab is changed"
//USAGE flag "--headed" help="Show the browser when launching an ephemeral browser"
//USAGE flag "--intervene" help="Launch a dedicated visible browser and retain challenges for human intervention"

import { fileURLToPath } from 'node:url';
import { runBrowser } from '../../../scripts/zillow/browser-command.mjs';
import { handoff } from '../../../scripts/zillow/handoff.mjs';
import { requestedListing, calculatorOptions } from '../../../scripts/zillow/listing.mjs';

try {
  const { url } = requestedListing(process.env.usage_url);
  const { calculator, unit } = calculatorOptions({
    calculator: process.env.usage_calculator === 'true',
    unit: process.env.usage_unit ?? null,
  });
  const intervention = process.env.usage_intervene === 'true';
  const browser = process.env.usage_browser || undefined;
  const headed = process.env.usage_headed === 'true';
  if (intervention && browser) {
    throw new Error('--intervene owns a dedicated browser; cannot combine with --browser');
  }

  let result;
  if (intervention) {
    result = handoff({ operation: 'listing', url, calculator, unit });
  } else {
    const script = fileURLToPath(new URL('../../../scripts/zillow/listing.mjs', import.meta.url));
    const args = [url];
    if (calculator) args.push('--calculator');
    if (unit !== null) args.push('--unit', unit);
    result = runBrowser(script, args, { browser, headed });
  }
  console.log(JSON.stringify(result, null, 2));
} catch (error) {
  console.error(`zillow listing: ${error instanceof Error ? error.message : String(error)}`);
  process.exitCode = 1;
}
