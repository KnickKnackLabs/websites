#!/usr/bin/env bun
//MISE description="Show Zillow property facts, description, location and photo evidence"
//USAGE arg "<url>" help="Zillow homedetails or building URL"
//USAGE flag "--calculator" help="Read the cost calculator when available"
//USAGE flag "--browser <id>" help="Use an existing browser with a new owned tab"
//USAGE flag "--headed" help="Show the ephemeral browser"
//USAGE flag "--intervene" help="Keep verification open in a dedicated visible browser for human help"
import { fileURLToPath } from 'node:url';
import { requestedListing } from '../../../../scripts/zillow/listing.mjs';
import { runBrowser } from '../../../../scripts/zillow/task.mjs';
import { handoff } from '../../../../scripts/zillow/handoff.mjs';

try {
  const { url } = requestedListing(process.env.usage_url);
  const calculator = process.env.usage_calculator === 'true';
  const intervention = process.env.usage_intervene === 'true';
  if (intervention && process.env.usage_browser) throw new Error('--intervene owns a dedicated browser; cannot combine with --browser');
  const result = intervention ? handoff({ operation: 'property', url, calculator })
    : runBrowser(fileURLToPath(new URL('../../../../scripts/zillow/property.mjs', import.meta.url)),
      calculator ? [url, '--calculator'] : [url], {
        browser: process.env.usage_browser || undefined, headed: process.env.usage_headed === 'true',
      });
  console.log(JSON.stringify(result, null, 2));
} catch (error) {
  console.error(`zillow property show: ${error instanceof Error ? error.message : String(error)}`);
  process.exitCode = 1;
}
